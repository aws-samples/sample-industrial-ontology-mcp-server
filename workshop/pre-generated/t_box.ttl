    rdfs:label "environment module"@en .

steel:EquipmentMaster a owl:Class ;
    rdfs:label "Equipment Master"@en,
        "설비 마스터"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "equipmentId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-equipment ;
    rdfs:comment "CQ10 참고: 설비(가스·스팀·폐기물)와 환경 모니터링 지점(소음·토양·수질) 사이 FK 가 CSV 에 없다. 두 클러스터 연결은 Location 텍스트 매칭 또는 별도 매핑 마스터 수집으로만 가능하다."^^xsd:string,
        "설비의 식별자, 명칭, 유형, 설치 위치, 제조사를 관리하는 설비 기준 정보이다."@ko ;
    rdfs:subClassOf steel:EquipmentAsset,
        steel:EquipmentMaster_equipmentHasEnergyEfficiencyRecord_someValuesFrom,
        steel:MasterData ;
    owl:hasKey ( steel:equipmentMasterId ) .

