<http://example.com/steel-ontology> a owl:Ontology ;
    rdfs:label "Steel Manufacturing Sample Ontology"@en,
        "철강 제조 샘플 온톨로지"@ko ;
    dcterms:creator "Steel Ontology Sample Team"^^xsd:string ;
    dcterms:description "IOF-aligned ontology for steel manufacturing processes, equipment, quality, energy, environment, and supply chain management."@en,
        "IOF 기반 철강 제조 공정, 설비, 품질, 에너지, 환경, 공급망 관리 온톨로지"@ko ;
    dcterms:license <https://spdx.org/licenses/MIT-0.html> ;
    dcterms:provenance "Generated by an Amazon Bedrock model through a multi-agent debate workflow; domain expert review is required before use."^^xsd:string ;
    dcterms:subject "BFO"^^xsd:string,
        "IOF"^^xsd:string,
        "industrial ontology"^^xsd:string,
        "knowledge graph"^^xsd:string,
        "steel manufacturing"^^xsd:string,
        "공정"^^xsd:string,
        "설비"^^xsd:string,
        "제조"^^xsd:string,
        "철강"^^xsd:string,
        "품질"^^xsd:string ;
    rdfs:comment "IOF-based Steel Manufacturing T-Box Ontology (v2.1.0 -- quality-improved)"@en,
        "IOF 기반 철강 제조 공정, 설비, 품질, 에너지, 환경, 공급망 관리 온톨로지 (v2.1.0 -- 품질 개선)"@ko ;
    owl:imports <https://spec.industrialontologies.org/ontology/core/Core/>,
        <https://spec.industrialontologies.org/ontology/maintenance/Maintenance/>,
        <https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/> ;
    owl:versionIRI <http://example.com/steel-ontology/2.1.0> ;
    owl:versionInfo "2.1.0"^^xsd:string .

