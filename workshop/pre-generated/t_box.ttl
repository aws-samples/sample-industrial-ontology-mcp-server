steel:airEmissionMonitoringConcentration a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring concentration"@en,
        "대기 오염물질 농도"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Concentration"^^xsd:string ;
    rdfs:comment "측정된 대기오염물질의 농도 값이다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:decimal .

steel:airEmissionMonitoringPointId a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring point ID"@en,
        "대기 배출 측정 지점 코드"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Point_ID"^^xsd:string ;
    rdfs:comment "측정이 수행된 지점의 참조 코드를 문자열로 보존한 값이다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:string .

steel:airEmissionMonitoringPollutantType a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring pollutant type"@en,
        "대기 오염물질 종류"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Pollutant_Type"^^xsd:string ;
    rdfs:comment "측정 대상이 된 대기오염물질의 종류를 나타낸다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:string .

steel:airEmissionMonitoringStackId a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring stack ID"@en,
        "대기 배출 굴뚝 코드"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Stack_ID"^^xsd:string ;
    rdfs:comment "측정 대상 굴뚝 또는 배출구의 참조 코드를 문자열로 보존한 값이다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:string .

steel:airEmissionMonitoringTimestamp a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring timestamp"@en,
        "대기 배출 측정 시각"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Timestamp"^^xsd:string ;
    rdfs:comment "대기오염물질 농도를 측정한 시점이다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:dateTime .

steel:airEmissionMonitoringUnit a owl:DatatypeProperty ;
    rdfs:label "air emission monitoring unit"@en,
        "대기 배출 측정 단위"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Unit"^^xsd:string ;
    rdfs:comment "대기오염물질 농도 값에 적용된 측정 단위이다."@ko ;
    rdfs:domain steel:AirEmissionMonitoring ;
    rdfs:range xsd:string .

steel:alarmEventsAlarmType a owl:DatatypeProperty ;
    rdfs:label "alarm events alarm type"@en,
        "알람 유형"@ko ;
    dcterms:isPartOf steel:module-equipment ;
    dcterms:source "Alarm_Type"^^xsd:string ;
    rdfs:comment "상한 초과, 하한 미달, 통신 이상 등 알람의 유형을 나타낸다."@ko ;
    rdfs:domain steel:AlarmEvents ;
    rdfs:range xsd:string .

steel:alarmEventsMessage a owl:DatatypeProperty ;
    rdfs:label "alarm events message"@en,
        "알람 메시지"@ko ;
    dcterms:source "Message"^^xsd:string ;
    rdfs:comment "알람 발생 내용을 설명하는 메시지 문구이다."@ko ;
    rdfs:domain steel:AlarmEvents ;
    rdfs:range xsd:string .

steel:alarmEventsSeverity a owl:DatatypeProperty ;
    rdfs:label "alarm events severity"@en,
        "알람 심각도"@ko ;
    dcterms:source "Severity"^^xsd:string ;
    rdfs:comment "알람의 심각도 등급을 나타낸다."@ko ;
    rdfs:domain steel:AlarmEvents ;
    rdfs:range xsd:string .

steel:alarmEventsTagId a owl:DatatypeProperty ;
    rdfs:label "alarm events tag ID"@en,
        "알람 태그 코드"@ko ;
    dcterms:isPartOf steel:module-equipment ;
    dcterms:source "Tag_ID"^^xsd:string ;
    rdfs:comment "알람이 발생한 계측 태그의 참조 코드를 문자열로 보존한 값이다."@ko ;
    rdfs:domain steel:AlarmEvents ;
    rdfs:range xsd:string .

steel:alarmEventsTimestamp a owl:DatatypeProperty ;
    rdfs:label "alarm events timestamp"@en,
        "알람 발생 시각"@ko ;
    dcterms:source "Timestamp"^^xsd:string ;
    rdfs:comment "알람이 발생한 시점이다."@ko ;
    rdfs:domain steel:AlarmEvents ;
    rdfs:range xsd:dateTime .

steel:blastFurnaceBlastVolumeM3min a owl:DatatypeProperty ;
    rdfs:label "blast volume per minute"@en,
        "송풍량"@ko ;
    dcterms:source "Blast_Volume_m3min"^^xsd:string ;
    rdfs:comment "고로에 분당 공급되는 송풍 체적이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceBurdenLevelM a owl:DatatypeProperty ;
    rdfs:label "burden level in meters"@en,
        "장입물 레벨"@ko ;
    dcterms:source "Burden_Level_m"^^xsd:string ;
    rdfs:comment "고로 내부 장입물의 높이 수준으로 단위는 미터이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceCO2Percent a owl:DatatypeProperty ;
    rdfs:label "carbon dioxide percent"@en,
        "이산화탄소 농도"@ko ;
    dcterms:source "CO2_Percent"^^xsd:string ;
    rdfs:comment "고로가스 중 이산화탄소의 부피 백분율이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceCOPercent a owl:DatatypeProperty ;
    rdfs:label "carbon monoxide percent"@en,
        "일산화탄소 농도"@ko ;
    dcterms:source "CO_Percent"^^xsd:string ;
    rdfs:comment "고로가스 중 일산화탄소의 부피 백분율이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceFuelRateKgh a owl:DatatypeProperty ;
    rdfs:label "blast furnace fuel rate"@en,
        "연료 취입량"@ko ;
    dcterms:isPartOf steel:module-energy ;
    dcterms:source "Fuel_Rate_kgh"^^xsd:string ;
    rdfs:comment "고로에 시간당 취입되는 미분탄 등 연료의 중량이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceGasFlowM3h a owl:DatatypeProperty ;
    rdfs:label "blast furnace gas flow rate"@en,
        "고로가스 유량"@ko ;
    dcterms:isPartOf steel:module-energy ;
    dcterms:source "Gas_Flow_m3h"^^xsd:string ;
    rdfs:comment "고로에서 발생하는 가스의 시간당 유량으로 단위는 세제곱미터이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceHotAirTempC a owl:DatatypeProperty ;
    rdfs:label "hot air temperature in Celsius"@en,
        "열풍 온도"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Hot_Air_Temp_C"^^xsd:string ;
    rdfs:comment "고로에 送風되는 열풍의 온도로 단위는 섭씨이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceIronOutputTon a owl:DatatypeProperty ;
    rdfs:label "hot metal output in tons"@en,
        "용선 생산량"@ko ;
    dcterms:source "Iron_Output_ton"^^xsd:string ;
    rdfs:comment "해당 조업 구간에서 생산된 용선의 중량으로 단위는 톤이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceIronTempC a owl:DatatypeProperty ;
    rdfs:label "hot metal temperature in Celsius"@en,
        "용선 온도"@ko ;
    dcterms:source "Iron_Temp_C"^^xsd:string ;
    rdfs:comment "출선된 용선의 온도로 단위는 섭씨이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceProductIdRef a owl:DatatypeProperty ;
    rdfs:label "blast furnace product identifier reference"@en,
        "고로 공정 제품 식별자"@ko ;
    dcterms:isPartOf steel:module-production ;
    dcterms:source "Product_ID"^^xsd:string ;
    rdfs:comment "고로 공정 기록이 참조하는 제품 식별자 값이다. composite PK (Product_ID + Timestamp) 의 식별 성분."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:string .

steel:blastFurnaceSlagVolumeM3h a owl:DatatypeProperty ;
    rdfs:label "slag volume per hour"@en,
        "슬래그 배출량"@ko ;
    dcterms:source "Slag_Volume_m3h"^^xsd:string ;
    rdfs:comment "고로에서 시간당 배출되는 슬래그의 체적이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

steel:blastFurnaceTimestamp a owl:DatatypeProperty ;
