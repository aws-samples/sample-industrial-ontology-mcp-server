    dcterms:source "Maintenance_Flag"^^xsd:string ;
    rdfs:comment "원천 CSV 가 'Y'/'N' 등 텍스트로 기록하므로 range 를 xsd:string 으로 완화했다. 불리언 해석은 A-Box 생성기 또는 질의 시 변환한다."^^xsd:string,
        "해당 시점에 정비가 필요하거나 정비 중임을 나타내는 표시이다."@ko ;
    rdfs:domain steel:EquipmentStatus ;
    rdfs:range xsd:boolean .

steel:equipmentStatusOperatingHours a owl:DatatypeProperty ;
