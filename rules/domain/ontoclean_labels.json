    "LandWaterMonitoring":   {"rigidity": "+R", "unity": "+U", "identity": "+I", "identity_by": "monitoringId",  "dependence": "+D"},
    "WasteNoiseMonitoring":  {"rigidity": "+R", "unity": "+U", "identity": "+I", "identity_by": "monitoringId",  "dependence": "+D"}
  }
}
