    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-production ;
    rdfs:comment "철광석과 코크스를 장입하여 용선을 생산하는 고로 조업의 운전 데이터를 기록한다."@ko ;
    rdfs:subClassOf steel:ProcessBlastFurnace_hasBlastFurnaceEquipment_someValuesFrom,
        steel:ProcessBlastFurnace_hasBlastFurnaceProduct_someValuesFrom,
        steel:SequentialProcessStage,
        iof-core:ManufacturingProcess .

steel:ProductionPlan a owl:Class ;
    rdfs:label "Production Plan"@en,
        "생산 계획"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "planId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-production ;
    rdfs:comment "Status 컬럼의 원본 문자열은 productionPlanStatusText 로 보존한다. Completed/InProgress 서브클래스는 대표 값만 커버하므로 그 외 값(Cancelled, On-Hold 등)은 원본 DP 로 조회한다."^^xsd:string,
        "제품별·설비별 일자 단위 생산 목표 수량과 실적 수량, 달성률을 기록한 생산 계획 정보이다."@ko ;
    rdfs:subClassOf steel:ProductionManagement,
        steel:ProductionPlan_productionPlanHasEquipment_someValuesFrom,
        steel:ProductionPlan_productionPlanHasProduct_someValuesFrom,
        iof-core:PlanSpecification ;
    owl:hasKey ( steel:productionPlanId ) .

steel:MonitoringPointMaster a owl:Class ;
    rdfs:label "Monitoring Point Master"@en,
        "모니터링 지점 마스터"@ko,
        "측정 지점 마스터"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-environment ;
    rdfs:comment "데이터 갭: Noise_Vibration_Monitoring/Soil_Monitoring/Water_Quality_Monitoring CSV 에 Equipment_ID 가 없고 Gas_Energy/Steam_Energy/Waste_Management CSV 에 Point_ID 가 없어 MonitoringPointMaster 와 EquipmentMaster 를 잇는 FK 가 존재하지 않는다. CQ10(환경 복합 위험 지수)은 MonitoringPointMaster.Location 과 EquipmentMaster.Location 텍스트 매칭 또는 Point_ID-Equipment_ID 매핑 마스터 신규 수집이 필요하며, 현재 T-Box 로는 답할 수 없다(unanswerable_cqs 등록 대상)."^^xsd:string,
        "환경 측정 지점과 EquipmentMaster 를 잇는 CSV FK(Point_ID-Equipment_ID 매핑)가 존재하지 않아 CQ10(소음·진동 ↔ 가스/스팀 에너지) 3-hop 경로는 현재 데이터로 답할 수 없다. SME 가 Point-Equipment 매핑 마스터 수집을 검토해야 한다."^^xsd:string,
        "환경 및 에너지 측정이 이루어지는 지점의 식별자와 위치 정보를 담은 기준 정보이다."@ko ;
    rdfs:subClassOf steel:MasterData,
        iof-core:Identifier,
        iof-core:PhysicalLocationIdentifier ;
    owl:hasKey ( steel:monitoringPointMasterId ) .

steel:ItemMaster a owl:Class ;
    rdfs:label "Item Master"@en,
        "품목 마스터"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
