    rdfs:subClassOf steel:NoiseVibrationMonitoring_hasNoiseMonitoringPoint_someValuesFrom,
        steel:WasteNoiseMonitoring ;
    owl:hasKey ( steel:noiseVibrationMonitorId ) .

steel:WasteManagement a owl:Class ;
    rdfs:label "Waste Management"@en,
        "폐기물 관리"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-environment ;
    rdfs:comment "Waste_Type 원본 문자열은 wasteManagementWasteTypeText 로 보존한다. General/Hazardous 2종 서브클래스로 분류되지 않는 세부 유형(슬래그, 분진, 폐유 등)은 원본 DP 로 조회한다."^^xsd:string,
        "설비에서 발생한 폐기물의 발생일, 종류, 발생량, 처리 방법 및 처리 업체를 기록하는 폐기물 관리 활동이다."@ko ;
    rdfs:subClassOf steel:WasteManagement_hasWasteEquipment_someValuesFrom,
        steel:WasteNoiseMonitoring ;
    owl:hasKey ( steel:wasteManagementId ) .

steel:ChemicalAnalysis a owl:Class ;
