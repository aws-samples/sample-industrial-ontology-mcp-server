    rdfs:subClassOf steel:SupplyChainMaster ;
    owl:hasKey ( steel:warehouseMasterCode ) .

steel:module-quality a skos:Collection ;
    rdfs:label "quality module"@en .

steel:ProductMaster a owl:Class ;
