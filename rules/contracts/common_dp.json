  "required_props_by_class": {
    "_comment": "클래스별 반드시 있어야 하는 DP 후보. Key 는 정확매칭 클래스명 또는 fnmatch 패턴 (\"*Monitoring\", \"Process*\"). 패턴은 concrete 클래스에 대해 resolve 된다. Value 는 DP 이름 list; dict entry 로 conditional 선언 ({\"dp\": \"hasSeverity\", \"if\": {\"dp\": \"hasResult\", \"op\": \"!=\", \"value\": \"Pass\"}}).",
    "*Monitoring": ["hasTimestamp"],
    "Process*": ["hasTimestamp"],
    "RealTimeData": ["hasTimestamp", "hasValue"],
    "AlarmEvents": ["hasTimestamp"],
    "EquipmentStatus": ["hasTimestamp", "hasStatus"],
    "InventoryTransaction": ["hasTimestamp", "hasQuantity"],
    "Transportation": ["hasOrigin", "hasDestination", "hasDepartureTime"],
    "PurchaseOrder": ["hasQuantity", "hasStatus"],
    "NDTResults": [
      "hasResult",
      {"dp": "hasSeverity", "if": {"dp": "hasResult", "op": "!=", "value": "Pass"}}
    ],
    "GHGEmission": ["hasTimestamp", "hasSourceType"],
    "AirEmissionMonitoring": ["hasTimestamp", "hasUnit"],
    "ElectricalConsumption": ["hasTimestamp"],
    "GasEnergy": ["hasTimestamp", "hasCalorificValue"],
    "FuelConsumption": ["hasTimestamp", "hasCalorificValue"],
    "ProductionPlan": ["hasStatus", "hasProcessType"],
    "ProductionResult": ["hasStatus", "hasProcessType"]
  }
