    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-production ;
    rdfs:comment "강종, 규격, 목표 인장강도 및 목표 항복강도 등 제품의 기준 정보를 관리한다."@ko ;
    rdfs:subClassOf steel:MasterData,
