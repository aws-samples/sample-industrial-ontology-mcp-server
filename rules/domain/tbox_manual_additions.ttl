# =============================================================================
# T-Box 수동 추가분 — 철강 예시 도메인
# =============================================================================
# step_30_tbox_manual_additions 가 S3(improve_tbox_quality) 후처리에서 자동 병합한다.
# 따라서 S2(generate_tbox_collaborative) 를 다시 돌려도 아래 추가분이 결정적으로
# 복원된다. @prefix 선언은 domain.namespaces 에서 자동 주입되므로 쓰지 않는다.
#
# ── 도입 근거 (2026-08-17) ────────────────────────────────────────────────
# S2 5라운드 토론에서 SME 가 veto lock 으로 3라운드 연속 지적한 항목:
#   "NoiseVibrationMonitoring↔EquipmentMaster 경로 부재 — Monitoring_Point_Master
#    CSV 에 Equipment_ID FK 가 없어 소음 초과 지점 인근 설비 특정 불가 (CQ10)"
#
# 실측 확인:
#   - Monitoring_Point_Master.csv 헤더: Point_ID, Point_Name, Location,
#     Media_Type, Regulation_Standard  → Equipment_ID **없음**
#   - Equipment_Master.csv 에 Location 있음. 두 CSV 의 Location 값 7종
#     (BF_Area / CC_Area / SM_Area / Rolling_Area / Production_Area /
#      Storage_Area 등) 이 **완전 일치** → co-location 조인 가능
#   - T-Box 에 NoiseVibrationMonitoring → EquipmentMaster OP 가 없어 tacit 이
#     트리플을 만들어도 **미선언 술어** 가 된다 (S9 FAIL 유발 — 이 리포에서
#     두 번 재발한 결함 계열: step_02 inverseOf 미선언, step_22 followedBy).
#
# 선례: rule_water_quality_inspection_equipment 가 같은 Location 공유 방식으로
# WaterQualityMonitoring → EquipmentMaster 를 5,580 트리플 채우고 있고, 그 OP
# (hasInspectionEquipment) 는 T-Box 에 선언돼 있다. 같은 패턴을 소음에 적용한다.
#
# ⚠️ 의미의 한계: 이 관계는 "같은 구역에 있다" 는 **근사** 다. 정확한 FK 가
# 아니므로 Monitoring_Point_Master 에 Nearest_Equipment_ID 컬럼이 확보되면
# rules/domain/tacit_rules.json 의 전략을 simple_join 으로 승격하고 이 주석을 갱신할 것.
#
# 대기(AirEmissionMonitoring) 쪽 주석 갱신 (2026-08-25) — 아래 "역방향 OP" 절 참조.
# 2026-08-17 에는 "hasStackEquipment / isStackEquipmentOf 가 이미 T-Box 에 선언돼
# 있으니 추가하지 말라" 고 적었다. **그 전제가 만료됐다**: 2026-08-25 S2 재실행이
# isStackEquipmentOf 를 지웠고(정방향만 생존), tacit 이 11,160 트리플로 채우는
# 관계가 역방향 조회 불가 상태가 됐다. 중복 우려도 실측으로 해소됐다 —
# (EquipmentMaster, AirEmissionMonitoring) 을 잇는 OP 는 현재 0개이고, 정방향
# hasStackEquipment 는 반대 쌍이라 step_22d 가 보는 키가 다르다.
# =============================================================================

# ── 소음·진동 측정 ↔ 설비 (co-location 근사, 정/역 쌍) ──
# 한쪽만 선언하면 owl:inverseOf 가 미선언 이름을 가리켜 역방향 트리플이 사라진다.
steel:noiseVibrationHasEquipment a owl:ObjectProperty ;
    rdfs:label "noise vibration has equipment"@en,
        "소음진동 측정 구역의 설비"@ko ;
    rdfs:comment "소음·진동 측정이 이루어진 모니터링 지점과 **같은 구역(Location)** 에 있는 설비를 연결한다. Monitoring_Point_Master 에 Equipment_ID FK 가 없어 Location 공유로 근사한 co-location 관계이며, 특정 설비가 소음원임을 단정하지 않는다. CQ10(소음 초과 지점 인근 설비의 에너지·폐기물 조회)의 진입 경로."@ko ;
    rdfs:domain steel:NoiseVibrationMonitoring ;
    rdfs:range steel:EquipmentMaster ;
    owl:inverseOf steel:isEquipmentOfNoiseVibration .

steel:isEquipmentOfNoiseVibration a owl:ObjectProperty ;
    rdfs:label "is equipment of noise vibration"@en,
        "설비 구역의 소음진동 측정"@ko ;
    rdfs:comment "설비와 **같은 구역(Location)** 에서 이루어진 소음·진동 측정을 연결한다. noiseVibrationHasEquipment 의 역관계로, 설비 기준 소음 이력 조회에 쓴다. co-location 근사이므로 인과(이 설비가 이 소음을 냈다)로 읽지 말 것."@ko ;
    rdfs:domain steel:EquipmentMaster ;
    rdfs:range steel:NoiseVibrationMonitoring ;
    owl:inverseOf steel:noiseVibrationHasEquipment .

# =============================================================================
# 마스터 → 매핑/거래 역방향 OP (2026-08-25 추가)
# =============================================================================
# 도입 근거 — S9 "Closed-World master 고립" 이 ItemSupplierMap 98/98 = 100% 로
# FAIL 했다. A-Box 는 온전한데(정방향 각 98건) 체크가 FAIL 한 이유:
#
#   cw_master_orphan 은 "master URI 가 **객체 위치**로 참조되는가" 만 센다
#   (referential.py: `?s ?p ?o` 의 ?o 만 수집). mapping/거래 테이블은 자기가
#   주체로서 마스터를 가리키기만 하므로, 역방향 OP 가 없으면 정의상 100% 고아다.
#
# 직전 배포본에는 이 6개가 있어서 통과했고, 2026-08-25 S2 재실행이 산출물을
# 67클래스 → 49클래스로 줄이면서 함께 사라졌다 (save_guard 는 collapse 판정
# 임계 아래여서 통과). 즉 **재실행마다 우연에 맡겨진 상태** 였다.
#
# 근거는 이름 점수가 아니라 실측 사용량이다 — 정방향 쌍이 A-Box 를 채우고 있고,
# load_graph() 의 ensure_inverse_triples() 가 owl:inverseOf 선언을 보고 역방향
# 트리플을 만든다. 선언이 없으면 그 복원 경로 자체가 없다:
#
#   itemSupplierMapHasItem            98    inventoryStatusHasItem           85
#   itemSupplierMapHasSupplier        98    inventoryStatusHasWarehouse      85
#   inventoryTransactionHasItem      600    inventoryTransactionHasWarehouse 600
#   purchaseOrderHasWarehouse        109    (2026-08-26 추가 — 위 6개와 같은 축인데
#                                           손으로 고를 때 빠뜨렸고 게이트가 잡았다)
#
# 정/역 쌍을 **함께** 선언한다 — 한쪽만 두면 owl:inverseOf 가 미선언 이름을
# 가리켜 S9 "미선언 ObjectProperty" 로 옮겨 붙는다 (이 리포에서 세 번 재발한
# 결함 계열: step_02 inverseOf, step_22 followedBy, 그리고 이 건).
# 정방향은 S2 가 생성하므로 여기서는 역방향만 선언하고 inverseOf 로 잇는다.

# ── 품목/공급업체 ↔ 매핑 ──
steel:isItemOfSupplierMap a owl:ObjectProperty ;
    rdfs:label "is item of supplier mapping"@en,
        "품목의 공급업체 매핑"@ko ;
    rdfs:comment "품목에서 그 품목의 공급업체 매핑 레코드로 가는 역방향 경로. itemSupplierMapHasItem 의 역관계로, 품목 기준 조달 경로 조회(어느 공급업체가 이 품목을 대는가)의 진입점이다."@ko ;
    rdfs:domain steel:ItemMaster ;
    rdfs:range steel:ItemSupplierMap ;
    owl:inverseOf steel:itemSupplierMapHasItem .

steel:isSupplierOfItemSupplierMap a owl:ObjectProperty ;
    rdfs:label "is supplier of item supplier mapping"@en,
        "공급업체의 품목 매핑"@ko ;
    rdfs:comment "공급업체에서 그 업체가 공급하는 품목 매핑 레코드로 가는 역방향 경로. itemSupplierMapHasSupplier 의 역관계로, 공급업체 기준 취급 품목 조회에 쓴다."@ko ;
    rdfs:domain steel:SupplierMaster ;
    rdfs:range steel:ItemSupplierMap ;
    owl:inverseOf steel:itemSupplierMapHasSupplier .

# ── 품목/창고 ↔ 재고 현황 ──
steel:isItemOfInventoryStatus a owl:ObjectProperty ;
    rdfs:label "is item of inventory status"@en,
        "품목의 재고 현황"@ko ;
    rdfs:comment "품목에서 그 품목의 재고 현황 레코드로 가는 역방향 경로. inventoryStatusHasItem 의 역관계."@ko ;
    rdfs:domain steel:ItemMaster ;
    rdfs:range steel:InventoryStatus ;
    owl:inverseOf steel:inventoryStatusHasItem .

steel:warehouseHasInventoryStatus a owl:ObjectProperty ;
    rdfs:label "warehouse has inventory status"@en,
        "창고의 재고 현황"@ko ;
    rdfs:comment "창고에서 그 창고의 재고 현황 레코드로 가는 역방향 경로. inventoryStatusHasWarehouse 의 역관계로, 창고 기준 보유 재고 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:InventoryStatus ;
    owl:inverseOf steel:inventoryStatusHasWarehouse .

# ── 품목/창고 ↔ 재고 거래 ──
steel:isItemOfInventoryTransaction a owl:ObjectProperty ;
    rdfs:label "is item of inventory transaction"@en,
        "품목의 재고 거래"@ko ;
    rdfs:comment "품목에서 그 품목의 입출고 거래 레코드로 가는 역방향 경로. inventoryTransactionHasItem 의 역관계."@ko ;
    rdfs:domain steel:ItemMaster ;
    rdfs:range steel:InventoryTransaction ;
    owl:inverseOf steel:inventoryTransactionHasItem .

steel:warehouseHasInventoryTransaction a owl:ObjectProperty ;
    rdfs:label "warehouse has inventory transaction"@en,
        "창고의 재고 거래"@ko ;
    rdfs:comment "창고에서 그 창고를 거친 입출고 거래 레코드로 가는 역방향 경로. inventoryTransactionHasWarehouse 의 역관계로, 창고 기준 물류 이력 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:InventoryTransaction ;
    owl:inverseOf steel:inventoryTransactionHasWarehouse .

# ── 창고 ↔ 발주 ──
# 2026-08-26 추가. 위 6개를 등록할 때 **같은 축인데 빠뜨렸다** — 회귀 테스트
# (test_deployed_tbox_has_no_live_link_loss) 가 S3 재실행 후 이 한 건을 잡아냈다.
# 실측: purchaseOrderHasWarehouse 가 A-Box 109 트리플을 채우는데 역방향은 T-Box 에
# 선언조차 없었다. 손으로 고른 목록은 빠짐이 생긴다는 것이 이 축의 존재 이유다
# (앞서 isStackEquipmentOf 도 같은 경위로 게이트가 찾아냈다).
steel:warehouseHasPurchaseOrder a owl:ObjectProperty ;
    rdfs:label "warehouse has purchase order"@en,
        "창고의 발주"@ko ;
    rdfs:comment "창고에서 그 창고를 입고지로 지정한 발주 레코드로 가는 역방향 경로. purchaseOrderHasWarehouse 의 역관계로, 창고 기준 입고 예정 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:PurchaseOrder ;
    owl:inverseOf steel:purchaseOrderHasWarehouse .

# ── 창고 ↔ 운송 (출발지) — 2026-09-05 제거 ──
# 예전에는 여기서 `warehouseIsOriginOfTransportation`(inverseOf
# `transportationHasOriginWarehouse`) 을 선언해 역방향 경로를 복원했다. **S2 가 그
# 쌍을 스스로 만들기 시작해 이 블록이 중복이 됐다.** 실측 2026-09-05 배포 T-Box:
#
#   hasOriginWarehouse / isOriginWarehouseOf                 (S2 생성)   각 300 트리플
#   transportationHasOriginWarehouse / warehouseIsOriginOf…  (이 블록)   각 0 트리플
#
# 같은 (domain, range, dcterms:source=Origin_Warehouse) 를 두 쌍이 주장하면 A-Box
# 생성기가 authoritative 매핑을 버리고 이름 추측 폴백에 맡긴다 (step_12k 주석 참조).
# 그리고 이 파일은 git 추적인데 T-Box 는 gitignore 라, 여기에 이름을 박아 두면 S2 가
# 개명할 때마다 0행 유령 쌍이 영구히 남는다.
#
# 이름을 갱신하는 대신 **제거** 한다 — 다시 필요해지면 그때는 이름이 또 다를 것이고,
# 필요 여부는 이름에 의존하지 않는 테스트가 판정한다
# (`tests/test_fk_column_direction_affinity.py::TestDeployedAboxHasBothWarehouseDirections`
# 가 dcterms:source 로 OP 를 해상해 "두 방향이 CSV 와 일치하는가" 를 본다).

# ── 설비 ↔ 대기 배출 측정 (tacit co-location 근사, 역방향) ──
# 위 6개와 같은 계열이지만 **발견 경로가 다르다**: 이 건은 손으로 찾은 것이 아니라
# 새로 넣은 산-경로 가드(_SAVE_LIVE_LINK_LOSS_MAX)가 잡았다. 6개를 복원한 뒤에도
# "A-Box·tacit 이 채우는 관계 1개 소실" 로 남아 차단됐고, 그 1개가 이것이었다.
#
# 근거: 정방향 hasStackEquipment 가 A-Box 1,560 / tacit 11,160 트리플을 채운다
# (tacit_colocation.ttl). 역방향 선언이 없으면 "이 설비의 대기 배출 이력" 조회가
# 에러 없이 0건을 반환한다. CSV 에 직접 FK 는 없다 —
# Air_Emission_Monitoring 헤더는 Stack_ID 뿐이고 Equipment_ID 가 없어
# Stack_ID↔Equipment_ID 코드체계 매핑은 미검증이다. 원래 선언의 dcterms:source 도
# 그 사실을 "none:… 매핑 미검증" 으로 기록하고 있었다.
#
# ⚠️ 의미의 한계: co-location 근사이므로 "이 설비가 이 오염물질을 배출했다" 는
# 인과로 읽지 말 것. Air_Emission_Monitoring 에 Equipment_ID 가 확보되면
# tacit_rules.json 전략을 simple_join 으로 승격하고 이 주석을 갱신하라.
steel:isStackEquipmentOf a owl:ObjectProperty ;
    rdfs:label "is stack equipment of"@en,
        "배출구 설비임"@ko ;
    rdfs:comment "설비에서 그 설비 배출구(Stack)에서 수행된 대기 배출 측정 기록으로 가는 역방향 경로. hasStackEquipment 의 역관계로, 설비 기준 대기 배출 이력 조회에 쓴다. Stack_ID↔Equipment_ID 매핑이 미검증인 co-location 근사이므로 인과로 해석하지 말 것."@ko ;
    rdfs:domain steel:EquipmentMaster ;
    rdfs:range steel:AirEmissionMonitoring ;
    owl:inverseOf steel:hasStackEquipment .

# ── composite PK 클래스의 FK 식별자 DP (2026-08-28) ──
# 왜 필요한가: 시계열 5개 클래스는 composite PK (FK + Timestamp) 인데 T-Box 에
# FK 식별자 DP 가 없어 A-Box 가 `dcterms:identifier` 폴백으로 떨어졌고, 그 값이
# "EQ001|2025-09-01 06:00:00" 형태 **합성 조인키** 였다 (59,280건 = 인스턴스 84%).
#
# `dcterms:identifier` 는 표준 어휘라 외부 시스템(MES/ERP)이 그 값으로 조회한다.
# 파이프 합성값은 어느 시스템에도 없어 조인이 불가능하고 LLM 도 조회 키로 오인한다.
# 그래서 A-Box 생성기가 composite PK 에는 그 폴백을 쓰지 않도록 고쳤는데
# (_is_composite_pk), 그것만으로는 **FK 값이 리터럴로 아예 남지 않는다** — 실측:
# EQ001 / P001 이 IRI 와 OP 링크에만 있고 리터럴 술어는 0건이었다.
#
# RealTimeData 만 예외적으로 온전했던 이유가 답을 줬다: 그 클래스에는
# `realTimeDataTagIdRef` (dcterms:source = Tag_ID) 가 T-Box 에 선언돼 있어 A-Box 가
# FK 값을 리터럴로 채운다. 아래 5개는 같은 형식을 따른다.
#
# 시각 성분은 이미 각 클래스의 `*Timestamp` DP 에 xsd:dateTime 으로 온전히 있으므로
# 여기서 다루지 않는다 (합성값보다 타입이 있어 비교·정렬에 낫다).

steel:equipmentStatusEquipmentIdRef a owl:DatatypeProperty ;
    rdfs:label "equipment status equipment identifier reference"@en,
        "설비 상태 설비 식별자"@ko ;
    rdfs:comment "설비 상태 기록이 참조하는 설비 식별자 값이다. composite PK (Equipment_ID + Timestamp) 의 식별 성분으로, 외부 시스템 조인 키로 쓴다."@ko ;
    rdfs:domain steel:EquipmentStatus ;
    rdfs:range xsd:string ;
    dcterms:source "Equipment_ID" .

steel:blastFurnaceProductIdRef a owl:DatatypeProperty ;
    rdfs:label "blast furnace product identifier reference"@en,
        "고로 공정 제품 식별자"@ko ;
    rdfs:comment "고로 공정 기록이 참조하는 제품 식별자 값이다. composite PK (Product_ID + Timestamp) 의 식별 성분."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:string ;
    dcterms:source "Product_ID" .




steel:realTimeDataTagIdRef a owl:DatatypeProperty ;
    rdfs:label "real time data tag identifier reference"@en,
        "실시간 데이터 태그 식별자"@ko ;
    rdfs:comment "실시간 데이터가 참조하는 계측 태그 식별자 값이다. composite PK (Tag_ID + Timestamp) 의 식별 성분으로, 외부 시스템 조인 키로 쓴다."@ko ;
    rdfs:domain steel:RealTimeData ;
    rdfs:range xsd:string ;
    dcterms:source "Tag_ID" .
