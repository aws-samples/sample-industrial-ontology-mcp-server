# ── AWS ──────────────────────────────────────────────────────────────
# 워크샵 참가자: Bedrock 은 아래 BEDROCK_REGION(us-east-1)을 쓰므로 그대로 둬도
# Claude 호출은 정상. AWS_REGION 은 일반 AWS 호출(sts 등)용 — 본인 계정 기본
# 리전에 맞추세요. 혼란을 피하려면 워크샵 중엔 us-east-1 로 통일해도 무방.
AWS_REGION=ap-northeast-2
# AWS_PROFILE 미설정 시 boto3 기본 자격증명 체인 사용 (default / IAM Role / SSO /
# AWS_BEARER_TOKEN_BEDROCK). 명시 프로파일이 필요할 때만 주석 해제.
# AWS_PROFILE=default

# ── Bedrock ──────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1
BEDROCK_READ_TIMEOUT=300
# BEDROCK_MAX_TOKENS=32000
# BEDROCK_MAX_RETRIES=2

# Multi-Agent 모델 다양화 (선택) — 역할별 다른 모델로 same-model 편향 완화.
# 미설정 시 모두 BEDROCK_MODEL_ID 사용.
# 권장: Architect/Jury=Opus (설계·최종판정) / Validator=Haiku (빠른 검사) /
#       SME·Compromise=Sonnet (균형·감사기록).
# MULTI_AGENT_MODEL_ARCHITECT=us.anthropic.claude-opus-5
# MULTI_AGENT_MODEL_VALIDATOR=us.anthropic.claude-haiku-4-5-20251001-v1:0
# MULTI_AGENT_MODEL_SME=us.anthropic.claude-sonnet-5
# MULTI_AGENT_MODEL_JURY=us.anthropic.claude-opus-5
# MULTI_AGENT_MODEL_COMPROMISE=us.anthropic.claude-sonnet-5
#
# opus-5 / sonnet-5 주의사항 (2026-08-18 실측):
#  - adaptive thinking 기본 ON → 응답 첫 블록이 {"type":"thinking"}.
#    tools/bedrock.py 의 _extract_text 가 text 블록만 골라내므로 동작한다.
#  - temperature 를 거부하지만 bedrock.py 가 자동 제거 후 재시도한다.
#  - claude-fable-5 는 30일 데이터 보존 설정이 필수 (기본 계정은 400).

# ── Java (OWL 추론기 HermiT/Pellet용, **Java 25+ 필수**) ──────────────
# HermiT 은 11+ 로 동작하지만 Pellet 은 25 미만에서 UnsupportedClassVersionError 로
# 죽는다 (owlready2 0.50 의 Jena jar 가 class 69 바이트코드를 담고 있다 —
# CVE-2021-39239 패치 부산물). 25 미달이면 ontology_agent_health_check 이 degraded 를 보고하고,
# S4 (HermiT) 는 통과하므로 그 통과를 Pellet 정상으로 읽지 말 것.
# 본인 OS 의 실제 java 경로로 채우세요. 자동 확인: `readlink -f "$(which java)"`.
#   Linux:   /usr/bin/java  또는  /usr/lib/jvm/java-25-amazon-corretto.x86_64/bin/java
#   macOS:   /Library/Java/JavaVirtualMachines/amazon-corretto-25.jdk/Contents/Home/bin/java
#   Windows: C:\Program Files\Amazon Corretto\jdk25.0.0_37\bin\java.exe
JAVA_EXE=

# JVM heap (MB). 비우면 owlready2 기본값 2000 을 쓴다 — 그 값은 대규모 추론 그래프에서
# 부족하다 (실측: 1.37M 트리플에서 Pellet 이 OutOfMemoryError, 24000 에서 통과).
# S8.5 SWRL / validate_owl_realisation 을 큰 KG 에 돌리면 올려야 한다.
JAVA_MEMORY_MB=

# ── 선택 기능 ────────────────────────────────────────────────────────
# Neo4j (RCA 분석 / 그래프 시각화용)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# owl:imports 로컬 캐시 — 네트워크 차단 환경에서 IOF Core/SupplyChain/BFO 등을
# 미리 받아두면 OWL consistency 검증이 외부 호출 없이 동작. 미설정 시 IOF_LOCAL_DIR,
# <project>/data/external, 동봉된 <project>/data/source/reference 순으로 처음 존재하는
# 디렉터리를 쓴다.
# OWL_IMPORT_LOCAL_DIR=/path/to/external

# SWRL 추론 활성화 — rules/swrl/*.swrl 을 S8.5 에서 Pellet 으로 실행
# SWRL_ENABLED=true
# 시맨틱 딕셔너리 단위 불일치 경고 임계값 (max/min ratio, 0=비활성)
# UNIT_MISMATCH_RATIO=50
# 추론 triple per-triple justification 상한 (규칙별 reify 개수, 기본 200000)
# I2_MAX_REIFY=1000

# 서버 파일 로그. 미설정 시 운영체제 임시 디렉터리의
# ontology-agent-server.log를 사용하고, 빈 문자열이면 파일 로그를 끈다.
# ONTOLOGY_SERVER_LOG_FILE=

# A-Box의 on-demand DP는 기본적으로 generated T-Box overlay에 저장된다.
# 정본 t_box.ttl까지 함께 갱신해야 하는 레거시 호환 경로에서만 true로 설정한다.
ABOX_WRITE_TBOX_INJECTIONS=false

# ── T-Box 후처리 정책 (S3) ───────────────────────────────────────────
# 중복 ObjectProperty 제거 (step_22e). off(기본) | on
#
# 같은 (domain, range) 를 잇는 OP 가 여럿이면 CSV FK 컬럼은 방향당 하나뿐이라
# A-Box 는 그중 하나만 채운다. 나머지는 값 0건이고 **빈 관계로 질의하면 에러 없이
# 0건이 정답처럼 반환된다**. 어느 이름이 채워지는지가 직렬화 순서에 좌우돼 무관한
# 변경에도 뒤집힌 이력이 있다 (isSlabOf 13,222건 → 0건).
#
# 기본이 off 인 이유: T-Box 어휘를 **실제로 삭제** 하므로 도메인 담당자가 정본 선정을
# 확인한 뒤 켜야 한다. 켜기 전 확인 절차 (2026-08-26 실측 기준):
#   1. step_22d 로그로 규모 확인 (중복 그룹 / 초과 OP 수)
#   2. keep/remove 각각의 A-Box·tacit 실사용량 — remove 쪽이 데이터를 가지면
#      keep 과 **주어 집합이 일치** 하는지 봐야 한다. 교집합이 0 이면 IRI 규약이
#      두 벌이라는 뜻이고 병합이 데이터를 뒤섞는다 (tacit source_composite_pk 확인)
#   3. remove 대상이 rules/*.json · CQ · 골든쿼리 · docs 에서 참조되는지
#      (단어 경계로 검사 — 부분 문자열은 오탐한다)
#   4. 적용 후 dangling 검사: inverseOf / Restriction onProperty / subPropertyOf 가
#      사라진 이름을 가리키지 않는지
#   5. A-Box 재생성 필수 — 정본 이름으로 값이 이동한다 (실측 17,480 트리플)
#
# 정본 강제 지정 (SME 가 정식 이름을 알려준 경우, 그룹당 하나):
# TBOX_DUP_OP_PRUNE_KEEP=이름1,이름2
# TBOX_DUP_OP_PRUNE=on
