    rdfs:domain steel:SupplierMaster ;
    rdfs:range steel:PurchaseOrder ;
    owl:inverseOf steel:purchaseOrderHasSupplier .

steel:isTransportedItemOf a owl:ObjectProperty ;
    rdfs:label "is transported item of"@en,
        "품목의 운송 실적"@ko ;
    dcterms:isPartOf steel:module-supply ;
    dcterms:source "Item_Code"^^xsd:string ;
    rdfs:comment "품목이 포함된 운송 실적을 역방향으로 연결한다."@ko ;
    rdfs:domain steel:ItemMaster ;
    rdfs:range steel:Transportation ;
    owl:inverseOf steel:transportationHasItem .

steel:isWaterMonitoringPointOf a owl:ObjectProperty ;
    rdfs:label "is water monitoring point of"@en,
        "수질 측정 지점 역관계"@ko,
        "지점의 수질 측정 기록"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Point_ID"^^xsd:string ;
    rdfs:comment "모니터링 지점에서 수행된 수질 측정 기록을 역방향으로 연결한다."@ko ;
    rdfs:domain steel:MonitoringPointMaster ;
    rdfs:range steel:WaterQualityMonitoring ;
    owl:inverseOf steel:hasWaterMonitoringPoint .

steel:itemMasterCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "item master code"@en,
        "품목 코드"@ko ;
    dcterms:source "Item_Code"^^xsd:string ;
    rdfs:comment "품목을 고유하게 식별하는 코드이다."@ko ;
    rdfs:domain steel:ItemMaster ;
    rdfs:range xsd:string .

steel:maintenanceHistoryId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "maintenance history identifier"@en,
        "정비 이력 식별자"@ko ;
    dcterms:source "Maintenance_ID"^^xsd:string ;
    rdfs:comment "정비 이력 건을 고유하게 구분하는 식별자이다."@ko ;
    rdfs:domain steel:MaintenanceHistory ;
    rdfs:range xsd:string .

steel:mechanicalPropertiesSampleId a owl:DatatypeProperty ;
    rdfs:label "mechanical properties sample ID"@en,
        "기계적 특성 시편 번호"@ko ;
    dcterms:source "Sample_ID"^^xsd:string ;
    rdfs:comment "기계적 특성 시험에 사용된 시편의 고유 식별자이다."@ko ;
    rdfs:domain steel:MechanicalProperties ;
    rdfs:range xsd:string .

steel:module-sensor a skos:Collection ;
    rdfs:label "sensor module"@en .

steel:monitoringPointMasterId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "monitoring point ID"@en,
        "모니터링 지점 번호"@ko ;
    dcterms:source "Point_ID"^^xsd:string ;
    rdfs:comment "환경 측정 지점을 구분하는 고유 식별자이다."@ko ;
    rdfs:domain steel:MonitoringPointMaster ;
    rdfs:range xsd:string .

steel:ndtResultsSampleId a owl:DatatypeProperty ;
    rdfs:label "NDT sample ID"@en,
        "비파괴검사 시편 번호"@ko ;
    dcterms:source "Sample_ID"^^xsd:string ;
    rdfs:comment "비파괴 검사 대상 시편의 고유 식별자이다."@ko ;
    rdfs:domain steel:NDTResults ;
    rdfs:range xsd:string .

steel:noiseVibrationHasEquipment a owl:ObjectProperty ;
    rdfs:label "noise vibration has equipment"@en,
        "소음진동 측정 구역의 설비"@ko ;
    dcterms:isPartOf steel:module-equipment ;
    rdfs:comment "소음·진동 측정이 이루어진 모니터링 지점과 **같은 구역(Location)** 에 있는 설비를 연결한다. Monitoring_Point_Master 에 Equipment_ID FK 가 없어 Location 공유로 근사한 co-location 관계이며, 특정 설비가 소음원임을 단정하지 않는다. CQ10(소음 초과 지점 인근 설비의 에너지·폐기물 조회)의 진입 경로."@ko ;
    rdfs:domain steel:NoiseVibrationMonitoring ;
    rdfs:range steel:EquipmentMaster ;
    owl:inverseOf steel:isEquipmentOfNoiseVibration .

steel:noiseVibrationMonitorId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "noise vibration monitor ID"@en,
        "소음·진동 측정 번호"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Monitor_ID"^^xsd:string ;
    rdfs:comment "소음·진동 측정 기록의 고유 식별자이다."@ko ;
    rdfs:domain steel:NoiseVibrationMonitoring ;
    rdfs:range xsd:string .

steel:productMasterId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "product master identifier"@en,
        "제품 식별자"@ko ;
    dcterms:source "Product_ID"^^xsd:string ;
    rdfs:comment "제품을 유일하게 식별하는 코드이다."@ko ;
    rdfs:domain steel:ProductMaster ;
    rdfs:range xsd:string .

steel:productionPlanHasResult a owl:ObjectProperty ;
    rdfs:label "production plan has result"@en,
        "생산 계획의 실적"@ko ;
    rdfs:comment "생산 계획에 대응하는 생산 실적을 연결한다."@ko ;
    rdfs:domain steel:ProductionPlan ;
    rdfs:range steel:ProductionResult ;
    owl:inverseOf steel:isResultOfProductionPlan .

steel:productionPlanId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "production plan id"@en,
        "생산 계획 식별자"@ko ;
    dcterms:source "Plan_ID"^^xsd:string ;
    rdfs:comment "생산 계획을 유일하게 식별하는 코드이다."@ko ;
    rdfs:domain steel:ProductionPlan ;
    rdfs:range xsd:string .

steel:productionResultId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "production result id"@en,
        "생산 실적 식별자"@ko ;
    dcterms:source "Result_ID"^^xsd:string ;
    rdfs:comment "생산 실적 기록을 유일하게 식별하는 코드이다."@ko ;
    rdfs:domain steel:ProductionResult ;
    rdfs:range xsd:string .

steel:soilImpactFrom a owl:ObjectProperty ;
    rdfs:label "soil impact from"@en,
        "토양 영향이 있다 (역)"@ko ;
    rdfs:comment "설비 운영의 토양 영향 (역방향)"@ko ;
    rdfs:domain steel:SoilMonitoring ;
    rdfs:range steel:EquipmentMaster ;
    owl:inverseOf steel:hasSoilImpact .

steel:soilMonitoringSampleId a owl:DatatypeProperty ;
    rdfs:label "soil monitoring sample id"@en,
        "토양 시료 식별자"@ko ;
    dcterms:isPartOf steel:module-environment ;
    dcterms:source "Sample_ID"^^xsd:string ;
    rdfs:comment "토양 측정 시료를 유일하게 식별하는 코드이다."@ko ;
    rdfs:domain steel:SoilMonitoring ;
    rdfs:range xsd:string .

steel:steamEnergyId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "steam energy id"@en,
        "스팀 에너지 식별자"@ko ;
    dcterms:isPartOf steel:module-energy ;
    dcterms:source "Steam_ID"^^xsd:string ;
    rdfs:comment "스팀 에너지 측정 기록의 고유 식별자."@ko ;
    rdfs:domain steel:SteamEnergy ;
    rdfs:range xsd:string .

steel:supplierMasterId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "supplier master id"@en,
        "공급업체 식별자"@ko ;
    dcterms:source "Supplier_ID"^^xsd:string ;
    rdfs:comment "공급업체를 구분하는 고유 식별자."@ko ;
    rdfs:domain steel:SupplierMaster ;
    rdfs:range xsd:string .

steel:surfaceQualitySampleId a owl:DatatypeProperty ;
    rdfs:label "surface quality sample id"@en,
        "표면 품질 시료 식별자"@ko ;
    dcterms:isPartOf steel:module-quality ;
    dcterms:source "Sample_ID"^^xsd:string ;
    rdfs:comment "표면 품질 검사에 사용된 시료의 고유 식별자."@ko ;
    rdfs:domain steel:SurfaceQuality ;
    rdfs:range xsd:string .

steel:tagEquipment a owl:ObjectProperty ;
    rdfs:label "tag equipment"@en,
        "tag equipment"@ko ;
    dcterms:isPartOf steel:module-equipment ;
    dcterms:source "Equipment_ID"^^xsd:string ;
    rdfs:comment "A-Box 가 50 트리플에서 사용 중인 관계 (step_15c 가 관측해 선언)"@ko ;
    rdfs:domain steel:TagMaster ;
    rdfs:range steel:EquipmentMaster .

steel:tagMasterId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "tag master id"@en,
        "태그 식별자"@ko ;
    dcterms:source "Tag_ID"^^xsd:string ;
    rdfs:comment "계측 태그를 구분하는 고유 식별자."@ko ;
    rdfs:domain steel:TagMaster ;
    rdfs:range xsd:string .

steel:warehouseHasInventoryStatus a owl:ObjectProperty ;
    rdfs:label "warehouse has inventory status"@en,
        "창고의 재고 현황"@ko ;
    dcterms:isPartOf steel:module-supply ;
    dcterms:source "Warehouse_Code"^^xsd:string ;
    rdfs:comment "창고에서 그 창고의 재고 현황 레코드로 가는 역방향 경로. inventoryStatusHasWarehouse 의 역관계로, 창고 기준 보유 재고 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:InventoryStatus ;
    owl:inverseOf steel:inventoryStatusHasWarehouse .

steel:warehouseHasInventoryTransaction a owl:ObjectProperty ;
    rdfs:label "warehouse has inventory transaction"@en,
        "창고의 재고 거래"@ko ;
    dcterms:isPartOf steel:module-supply ;
    dcterms:source "Warehouse_Code"^^xsd:string ;
    rdfs:comment "창고에서 그 창고를 거친 입출고 거래 레코드로 가는 역방향 경로. inventoryTransactionHasWarehouse 의 역관계로, 창고 기준 물류 이력 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:InventoryTransaction ;
    owl:inverseOf steel:inventoryTransactionHasWarehouse .

steel:warehouseHasPurchaseOrder a owl:ObjectProperty ;
    rdfs:label "warehouse has purchase order"@en,
        "창고의 발주"@ko ;
    dcterms:isPartOf steel:module-supply ;
    dcterms:source "Warehouse_Code"^^xsd:string ;
    rdfs:comment "창고에서 그 창고를 입고지로 지정한 발주 레코드로 가는 역방향 경로. purchaseOrderHasWarehouse 의 역관계로, 창고 기준 입고 예정 조회에 쓴다."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range steel:PurchaseOrder ;
    owl:inverseOf steel:purchaseOrderHasWarehouse .

steel:warehouseMasterCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "warehouse master code"@en,
        "창고 코드"@ko ;
    dcterms:source "Warehouse_Code"^^xsd:string ;
    rdfs:comment "창고를 구분하는 고유 코드."@ko ;
    rdfs:domain steel:WarehouseMaster ;
    rdfs:range xsd:string .

steel:wasteManagementId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "waste management identifier"@en,
        "폐기물 관리 식별자"@ko ;
    dcterms:source "Waste_ID"^^xsd:string ;
    rdfs:comment "폐기물 발생 기록을 고유하게 식별하는 번호이다."@ko ;
    rdfs:domain steel:WasteManagement ;
    rdfs:range xsd:string .

steel:waterQualityMonitoringSampleId a owl:DatatypeProperty ;
    rdfs:label "water quality sample identifier"@en,
        "수질 시료 식별자"@ko ;
    dcterms:isPartOf steel:module-quality ;
    dcterms:source "Sample_ID"^^xsd:string ;
    rdfs:comment "수질 측정을 위해 채취한 시료를 고유하게 식별하는 번호이다."@ko ;
    rdfs:domain steel:WaterQualityMonitoring ;
    rdfs:range xsd:string .

steel:EnergyInfrastructure a owl:Class,
        skos:Concept ;
    rdfs:label "Energy Infrastructure"@en,
        "에너지 기반 정보"@ko ;
    steel:completenessStatus "inferred"^^xsd:string ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "infraId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-energy ;
    rdfs:comment "에너지원 종류와 열량 등 에너지 사용 계산의 기준이 되는 정보를 묶는 개념이다."@ko ;
    rdfs:subClassOf steel:EnergyManagement ;
    skos:notation "category"@en ;
    skos:scopeNote "Abstract category (classification umbrella) — no discriminating data/object property of its own; serves as grouping parent."@en,
        "추상 카테고리(분류 묶음) — 자체 판별 속성 없이 그룹 부모 역할만 수행."@ko .

steel:EnergyPerformanceMeasurement a owl:Class,
        skos:Concept ;
    rdfs:label "Energy Performance Measurement"@en,
        "에너지 성능 측정"@ko ;
    steel:completenessStatus "inferred"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-energy ;
    rdfs:comment "에너지 투입 대비 산출 성능, 즉 효율 지표를 측정한 기록을 묶는 개념이다."@ko ;
    rdfs:subClassOf steel:EnergyManagement ;
    skos:notation "category"@en ;
    skos:scopeNote "Abstract category (classification umbrella) — no discriminating data/object property of its own; serves as grouping parent."@en,
        "추상 카테고리(분류 묶음) — 자체 판별 속성 없이 그룹 부모 역할만 수행."@ko .

steel:MaintenanceManagement a owl:Class,
        skos:Concept ;
    rdfs:label "Maintenance Management"@en,
        "정비 관리"@ko ;
    steel:completenessStatus "inferred"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "-D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-equipment ;
    rdfs:comment "설비 정비 계획과 실적, 고장 원인 관리 정보를 묶는 도메인 개념이다."@ko ;
    rdfs:subClassOf iof-core:DescriptiveInformationContentEntity ;
    skos:notation "category"@en ;
    skos:scopeNote "Abstract category (classification umbrella) — no discriminating data/object property of its own; serves as grouping parent."@en,
        "추상 카테고리(분류 묶음) — 자체 판별 속성 없이 그룹 부모 역할만 수행."@ko .

steel:MaterialProperty a owl:Class,
        skos:Concept ;
    rdfs:label "MaterialProperty"@en,
        "MaterialProperty"@ko ;
    steel:completenessStatus "inferred"^^xsd:string ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "sampleId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-quality ;
    rdfs:comment "품질 - MaterialProperty"@ko ;
    rdfs:subClassOf steel:QualityMeasurement ;
    skos:notation "category"@en ;
    skos:scopeNote "Abstract category (classification umbrella) — no discriminating data/object property of its own; serves as grouping parent."@en,
        "추상 카테고리(분류 묶음) — 자체 판별 속성 없이 그룹 부모 역할만 수행."@ko .

steel:MaterialPropertyMeasurement a owl:Class,
        skos:Concept ;
    rdfs:label "Material Property Measurement"@en,
        "재료 특성 측정"@ko ;
    steel:completenessStatus "inferred"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
