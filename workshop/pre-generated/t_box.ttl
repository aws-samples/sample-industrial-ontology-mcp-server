steel:PurchaseOrder a owl:Class ;
    rdfs:label "Purchase Order"@en,
        "구매 발주"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "poNumber"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-supply ;
    rdfs:comment "Status 컬럼의 원본 문자열은 purchaseOrderStatusText 로 보존한다. Delivered/Pending 서브클래스 외의 값(Partial, Cancelled 등)은 원본 DP 로 조회한다."^^xsd:string,
        "품목을 공급업체에 발주한 내역으로 수량, 단가, 총액, 납기 정보를 포함한다."@ko ;
    rdfs:subClassOf steel:PurchaseOrder_purchaseOrderHasItem_someValuesFrom,
        steel:PurchaseOrder_purchaseOrderHasSupplier_someValuesFrom,
        steel:PurchaseOrder_purchaseOrderHasWarehouse_someValuesFrom,
        steel:SupplyChainTransaction .

steel:ProcessBlastFurnace a owl:Class ;
    rdfs:label "Blast Furnace Process"@en,
        "고로 공정"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
