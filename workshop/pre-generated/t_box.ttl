    ns1:identityCriterion "consumptionId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-energy ;
    rdfs:comment "설비별 연료 소비량과 연료 종류, 열량, 단위당 비용을 기록한 측정 정보이다."@ko ;
    rdfs:domain owl:Thing ;
    rdfs:subClassOf steel:EnergyConsumption,
        steel:FuelConsumption_hasFuelEquipment_someValuesFrom,
        iof-core:MeasurementInformationContentEntity ;
    owl:hasKey ( steel:fuelConsumptionId ) .

steel:GHGEmission a owl:Class ;
    rdfs:label "GHG Emission"@en,
        "온실가스 배출"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "emissionId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-environment ;
    rdfs:comment "설비별 온실가스 배출 스코프, 배출원, 배출계수와 활동자료를 기록한 산정 정보이다."@ko ;
    rdfs:domain owl:Thing ;
    rdfs:subClassOf steel:AtmosphericMonitoring,
        steel:EnergyManagement,
        steel:GHGEmission_hasGHGEquipment_someValuesFrom,
        iof-core:MeasurementInformationContentEntity ;
    owl:disjointUnionOf ( steel:Scope1Emission steel:Scope2Emission steel:Scope3Emission ) ;
    owl:hasKey ( steel:ghgEmissionId ) .

steel:InventoryStatus a owl:Class ;
    rdfs:label "Inventory Status"@en,
        "재고 현황"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:autoLabel true ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "-I"^^xsd:string ;
    ns1:rigidity "-R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-supply ;
    rdfs:comment "CQ08 참고: 안전재고 미달 품목의 공급업체 조회는 InventoryStatus → ItemMaster → ItemSupplierMap → SupplierMaster 의 3-hop 조인이 필요하다. InventoryStatus→SupplierMaster 직접 FK 는 CSV 에 없으므로 직접 OP 를 신설하지 않는다."^^xsd:string,
        "품목별, 창고별, 구역별 현재고와 예약재고, 가용재고 상태를 나타낸다."@ko ;
    rdfs:subClassOf steel:InventoryStatus_inventoryStatusHasItem_someValuesFrom,
        steel:InventoryStatus_inventoryStatusHasWarehouse_someValuesFrom,
        steel:SupplyChainMapping ;
    owl:hasKey ( steel:inventoryStatusItemCode steel:inventoryStatusWarehouseCode ) .

steel:MaintenanceHistory a owl:Class ;
    rdfs:label "Maintenance History"@en,
        "정비 이력"@ko ;
    steel:completenessStatus "closed"^^xsd:string ;
    ns1:dependence "+D"^^xsd:string ;
    ns1:identity "+I"^^xsd:string ;
    ns1:identityCriterion "maintenanceId"^^xsd:string ;
    ns1:rigidity "+R"^^xsd:string ;
    ns1:unity "+U"^^xsd:string ;
    dcterms:isPartOf steel:module-equipment ;
    rdfs:comment "설비에 대해 수행된 정비 작업의 일자, 유형, 내용, 비용을 기록한 이력이다."@ko ;
    rdfs:subClassOf steel:MaintenanceHistory_hasMaintenanceEquipment_maxCardinality,
        steel:MaintenanceHistory_hasMaintenanceEquipment_someValuesFrom,
        steel:MaintenanceManagement ;
    owl:hasKey ( steel:maintenanceHistoryId ) .

steel:NoiseVibrationMonitoring a owl:Class ;
