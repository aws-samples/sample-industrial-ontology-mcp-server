steel:equipmentHasEnergyEfficiencyRecord a owl:ObjectProperty ;
    rdfs:label "equipment has energy efficiency record"@en,
        "is efficiency equipment of"@en,
        "설비의 에너지 효율 기록"@ko,
        "에너지 효율 측정의 대상 설비임"@ko ;
    dcterms:isPartOf steel:module-energy ;
    dcterms:source "Equipment_ID"^^xsd:string ;
    rdfs:comment "설비에 대해 산출된 에너지 효율 기록을 역방향으로 연결한다."@ko ;
    rdfs:domain steel:EquipmentMaster ;
    rdfs:range steel:EnergyEfficiency ;
    owl:inverseOf steel:hasEfficiencyEquipment .

steel:hasAlarmTag a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has alarm tag"@en,
