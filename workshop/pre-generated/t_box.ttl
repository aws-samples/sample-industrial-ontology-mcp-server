steel:blastFurnaceTopPressureKPa a owl:DatatypeProperty ;
    rdfs:label "furnace top pressure in kPa"@en,
        "노정 압력"@ko ;
    dcterms:source "Top_Pressure_kPa"^^xsd:string ;
    rdfs:comment "고로 상부의 가스 압력으로 단위는 킬로파스칼이다."@ko ;
    rdfs:domain steel:ProcessBlastFurnace ;
    rdfs:range xsd:decimal .

